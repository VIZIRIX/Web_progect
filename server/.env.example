# Переименуйте в .env и измените пароли на ваши.
#
# Варианты:
#  1. Локальный ПК (эта база): web_booking под пользователем postgres
#  2. Docker Compose: web_project_database под vizirix (ниже, закомментировано)
DATABASE_URL="postgresql://postgres@localhost:5432/web_booking?schema=public"
# DATABASE_URL="postgresql://vizirix:my_secure_password@postgres-db:5432/web_project_database?schema=public"
CLIENT_ORIGIN="http://localhost:5173"
JWT_SECRET="your_super_secret_key_here"
PORT=5000
