# Переименуйте в .env и измените пароли на ваши.
# Внимание: пароли в docker-compose по умолчанию (my_secure_password) совпадают с этими,
# но в продакшене замените их на реальные.
DATABASE_URL="postgresql://vizirix:my_secure_password@localhost:5432/web_project_database?schema=public"
JWT_SECRET="your_super_secret_key_here"
PORT=5000
