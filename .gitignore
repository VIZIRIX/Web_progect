# Зависимости Node.js (самая тяжелая папка, не нужная на другом ПК)
node_modules/
/dist
/build

# Локальные переменные окружения (пароли к БД, секреты)
.env
.env.local

# Файлы Prisma (логи, локальные БД вроде SQLite, если используются)
/prisma/.env
*.db
*.db-journal

# Системные файлы ОС и редакторов
.DS_Store
.vscode/
.idea/
*.log

# Сессионные записки/промпты и контекст (для продолжения; не нужны на GitHub)
PROJECT_STATE.md

# Сборка клиента (статика, генерируется при билде; не нужна на GitHub)
client/dist/
